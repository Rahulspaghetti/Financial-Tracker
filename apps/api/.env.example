# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=jdbc:postgresql://localhost:5432/tally
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_me_with_64_hex_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── Plaid ─────────────────────────────────────────────────────────────────────
PLAID_ENV=sandbox
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
# Fernet key: 32 url-safe base64 bytes (44 chars, usually ends with =)
# PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { [byte](Get-Random -Max 256) }))
PLAID_TOKEN_ENCRYPTION_KEY=your_fernet_key_here

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
