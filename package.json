{
  "name": "tally",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:web": "pnpm --filter @tally/web dev",
    "dev:api": "pnpm --filter @tally/api dev",
    "build:web": "pnpm --filter @tally/web build",
    "lint": "pnpm --filter @tally/web lint",
    "type-check": "pnpm --filter @tally/web type-check",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down -v"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.1.0"
}
